-- Keywords that identify a "steal" prompt (case-insensitive)
local StealKeywords = {"steal", "rob", "loot", "grab", "take"}

local function IsStealPrompt(prompt)
    local textToScan = string.lower((prompt.ActionText or "") .. " " .. (prompt.ObjectText or "") .. " " .. (prompt.Name or ""))
    for _, keyword in ipairs(StealKeywords) do
        if string.find(textToScan, keyword) then
            return true
        end
    end
    return false
end

