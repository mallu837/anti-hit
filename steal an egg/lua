-- Instant Pick Up Logic (Applies to existing and newly spawned prompts)
workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") and InstantPickupEnabled then
        if originalHoldDurations[descendant] == nil then
            originalHoldDurations[descendant] = descendant.HoldDuration
        end
        descendant.HoldDuration = 0
    end
end)

instantPickupBtn.MouseButton1Click:Connect(function()
    InstantPickupEnabled = not InstantPickupEnabled
    if InstantPickupEnabled then
        instantPickupBtn.Text = "Instant Pick Up: ON"
        instantPickupBtn.BackgroundColor3 = Theme.ActiveState
        instantStroke.Color = Theme.Border
        instantStroke.Transparency = 0.2
        for _, descendant in ipairs(workspace:GetDescendants()) do
            if descendant:IsA("ProximityPrompt") then
                if originalHoldDurations[descendant] == nil then
                    originalHoldDurations[descendant] = descendant.HoldDuration
                end
                descendant.HoldDuration = 0
            end
        end
    else
        instantPickupBtn.Text = "Instant Pick Up: OFF"
        instantPickupBtn.BackgroundColor3 = Theme.InactiveState
        instantStroke.Color = Theme.AccentPurple
        instantStroke.Transparency = 0.6
        for prompt, origDuration in pairs(originalHoldDurations) do
            if prompt and prompt.Parent then
                prompt.HoldDuration = origDuration
            end
        end
        table.clear(originalHoldDurations)
    end
end)

-- Speed Override Loop
RunService.Heartbeat:Connect(function()
    if SpeedOverrideEnabled then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.WalkSpeed ~= TargetSpeed then
                humanoid.WalkSpeed = TargetSpeed
            end
        end
    end
end)

